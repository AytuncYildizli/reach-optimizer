{
  "framework": "nextjs",
  "installCommand": "cd ../.. && corepack enable && pnpm install",
  "buildCommand": "npx prisma generate && npx next build",
  "crons": [
    {
      "path": "/api/cron/fetch-metrics",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/auto-optimize-pending",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/learn-weights",
      "schedule": "0 4 * * *"
    }
  ]
}
