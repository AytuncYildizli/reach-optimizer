{
  "framework": "nextjs",
  "installCommand": "corepack enable && pnpm install",
  "buildCommand": "pnpm turbo run build --filter=@reach/api",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/fetch-metrics",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/auto-optimize-pending",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/learn-weights",
      "schedule": "0 4 * * *"
    }
  ]
}
