# =============================================================================
# ReachOS - Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# --- Required ---

# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT secret for auth tokens (generate: openssl rand -hex 32)
JWT_SECRET="your-jwt-secret-here"

# X/Twitter OAuth 2.0 credentials (https://developer.x.com/en/portal)
X_CLIENT_ID="your-x-client-id"
X_CLIENT_SECRET="your-x-client-secret"

# --- Optional (features degrade gracefully without these) ---

# Anthropic API key for AI analysis (slop detection, hook suggestions)
# Without this: local rules-only scoring still works
ANTHROPIC_API_KEY=""

# twitterapi.io key for trending topics and tweet metrics
# Without this: no trending alignment, no post-mortem metrics
TWITTER_API_IO_KEY=""

# Optional trends provider override: twitterapi_io or xquik
TWITTER_TRENDS_PROVIDER="twitterapi_io"
XQUIK_API_KEY=""
XQUIK_API_BASE="https://xquik.com/api/v1"

# Public URL of your deployed API (used for OAuth callback)
# Default: http://localhost:3100
APP_URL="https://your-app.vercel.app"

# Secret to protect cron endpoints from unauthorized access
# Generate: openssl rand -hex 32
# Set the same value in your Vercel cron config
CRON_SECRET=""

# Ops database for batch auto-optimize (optional, advanced)
OPS_DATABASE_URL=""
