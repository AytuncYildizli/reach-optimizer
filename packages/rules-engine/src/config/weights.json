{
  "version": "4.0.0",
  "baseScore": 30,
  "signals": {
    "favorite":              { "maxPoints":  7,  "type": "positive", "bucket": "engagement" },
    "reply":                 { "maxPoints": 12,  "type": "positive", "bucket": "engagement" },
    "retweet":               { "maxPoints":  7,  "type": "positive", "bucket": "engagement" },
    "quote":                 { "maxPoints":  6,  "type": "positive", "bucket": "engagement" },
    "share":                 { "maxPoints":  5,  "type": "positive", "bucket": "engagement" },
    "share_via_dm":          { "maxPoints":  6,  "type": "positive", "bucket": "engagement" },
    "share_via_copy_link":   { "maxPoints":  4,  "type": "positive", "bucket": "engagement" },
    "click":                 { "maxPoints":  8,  "type": "positive", "bucket": "engagement" },
    "profile_click":         { "maxPoints":  7,  "type": "positive", "bucket": "curiosity" },
    "follow_author":         { "maxPoints":  5,  "type": "positive", "bucket": "curiosity" },
    "photo_expand":          { "maxPoints":  4,  "type": "positive", "bucket": "engagement", "conditional": "hasImage" },
    "vqv":                   { "maxPoints":  4,  "type": "positive", "bucket": "engagement", "conditional": "hasVideo" },
    "dwell":                 { "maxPoints":  8,  "type": "positive", "bucket": "dwell" },
    "cont_dwell_time":       { "maxPoints":  4,  "type": "positive", "bucket": "dwell" },
    "cont_click_dwell_time": { "maxPoints":  3,  "type": "positive", "bucket": "dwell", "conditional": "hasClickable" },
    "quoted_click":          { "maxPoints":  3,  "type": "positive", "bucket": "engagement", "conditional": "isQuoteTweet" },
    "quoted_vqv":            { "maxPoints":  2,  "type": "positive", "bucket": "engagement", "conditional": "isQuoteTweet+hasVideo" },
    "not_dwelled":           { "maxPenalty": -12, "type": "negative", "bucket": "risk" },
    "not_interested":        { "maxPenalty":  -8, "type": "negative", "bucket": "risk" },
    "block_author":          { "maxPenalty":  -8, "type": "negative", "bucket": "risk" },
    "mute_author":           { "maxPenalty":  -7, "type": "negative", "bucket": "risk" },
    "report":                { "maxPenalty": -15, "type": "negative", "bucket": "risk" }
  },
  "tiers": {
    "critical":      { "min": 0,  "max": 20, "label": "Don't Post" },
    "below_average": { "min": 21, "max": 40, "label": "Significant Revision Needed" },
    "good":          { "min": 41, "max": 60, "label": "Average" },
    "excellent":     { "min": 61, "max": 79, "label": "Strong" },
    "perfect":       { "min": 80, "max": 100, "label": "Exceptional" }
  }
}
