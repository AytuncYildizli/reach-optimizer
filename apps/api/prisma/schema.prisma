datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SubscriptionTier {
  free
  starter
  pro
  team
}

enum Platform {
  x
  linkedin
  threads
}

model User {
  id               String           @id @default(uuid()) @map("id")
  xUserId          String           @unique @map("x_user_id")
  xUsername         String           @map("x_username")
  xDisplayName     String           @map("x_display_name")
  xProfileImage    String?          @map("x_profile_image")
  xAccessToken     String           @map("x_access_token")
  xRefreshToken    String?          @map("x_refresh_token")
  subscriptionTier    SubscriptionTier @default(free) @map("subscription_tier")
  monthlyUsageCount   Int              @default(0) @map("monthly_usage_count")
  usageResetAt        DateTime         @default(now()) @map("usage_reset_at")
  personalizedWeights Json?            @map("personalized_weights")
  forecastCalibration Json?            @map("forecast_calibration")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  analyses      Analysis[]
  trackedTweets TrackedTweet[]

  @@map("users")
}

model Analysis {
  id              String   @id @default(uuid()) @map("id")
  userId          String   @map("user_id")
  contentText     String   @map("content_text")
  platform        Platform @default(x) @map("platform")
  reachScore      Int      @map("reach_score")
  hookScore       Int      @map("hook_score")
  structureScore  Int      @map("structure_score")
  engagementScore Int      @map("engagement_score")
  penaltyTotal    Int      @map("penalty_total")
  bonusTotal      Int      @map("bonus_total")
  aiSlopScore     Int?     @map("ai_slop_score")
  suggestions     Json     @default("[]") @map("suggestions")
  ruleResults     Json     @default("[]") @map("rule_results")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("analyses")
}

model TrackedTweet {
  id              String   @id @default(uuid())
  userId          String?  @map("user_id")
  tweetUrl        String   @map("tweet_url")
  xTweetId        String?  @map("x_tweet_id")
  content         String
  reachScore      Int      @map("reach_score")
  predictedReach  Int?     @map("predicted_reach")
  optimized       Boolean  @default(true)
  postedAt        DateTime @default(now()) @map("posted_at")
  createdAt       DateTime @default(now()) @map("created_at")
  user            User?    @relation(fields: [userId], references: [id])
  metrics         TweetMetric[]

  @@index([userId])
  @@index([xTweetId])
  @@map("tracked_tweets")
}

model TweetMetric {
  id              String       @id @default(uuid())
  trackedTweetId  String       @map("tracked_tweet_id")
  likes           Int          @default(0)
  retweets        Int          @default(0)
  replies         Int          @default(0)
  quotes          Int          @default(0)
  bookmarks       Int          @default(0)
  views           Int          @default(0)
  velocityScore   Float?       @map("velocity_score")
  measuredAt      DateTime     @default(now()) @map("measured_at")
  trackedTweet    TrackedTweet @relation(fields: [trackedTweetId], references: [id])

  @@index([trackedTweetId])
  @@map("tweet_metrics")
}
