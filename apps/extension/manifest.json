{
  "manifest_version": 3,
  "name": "ReachOS — Content Reach Optimizer",
  "version": "4.1.0",
  "description": "Real-time Reach Score for your tweets — aligned to xai-org/x-algorithm (May 2026). 25 signal predictors incl. ad-disclosure, video-first, post-frequency, BYOK AI.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "public/icons/icon-16.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "ReachOS"
  }
}
